{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mayajinjoon.github.io/arirang-surprisesong-tracker/data/tour.schema.json",
  "title": "BTS ARIRANG Tour master dataset",
  "type": "object",
  "required": ["schemaVersion", "project", "dataset", "rules", "legs", "sources", "shows"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "project": { "type": "object" },
    "dataset": { "type": "object" },
    "rules": { "type": "object" },
    "legs": { "type": "array", "items": { "$ref": "#/$defs/leg" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "shows": { "type": "array", "items": { "$ref": "#/$defs/show" } }
  },
  "$defs": {
    "leg": {
      "type": "object",
      "required": ["id", "label", "officialLabel"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "officialLabel": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "title", "publisher", "url", "type", "authority", "accessedAt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "publisher": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "type": { "type": "string" },
        "authority": { "enum": ["primary", "secondary"] },
        "accessedAt": { "type": "string", "format": "date" }
      },
      "additionalProperties": false
    },
    "song": {
      "type": "object",
      "required": ["title", "performanceOrder", "sourceIds"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "performanceOrder": { "type": "integer", "minimum": 1 },
        "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "show": {
      "type": "object",
      "required": ["id", "date", "status", "leg", "country", "city", "venue", "dayNumber", "label", "coordinates", "surpriseSongs", "specialPerformances", "scheduleSourceIds"],
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "enum": ["completed", "upcoming"] },
        "leg": { "type": "string" },
        "country": {
          "type": "object",
          "required": ["code", "name"],
          "properties": {
            "code": { "type": "string", "minLength": 2, "maxLength": 2 },
            "name": { "type": "string" }
          },
          "additionalProperties": false
        },
        "city": { "type": "string" },
        "venue": { "type": "string" },
        "dayNumber": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "coordinates": {
          "type": "object",
          "required": ["latitude", "longitude", "precision"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
            "precision": { "type": "string" }
          },
          "additionalProperties": false
        },
        "surpriseSongs": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/song" } },
        "specialPerformances": { "type": "array", "items": { "type": "object" } },
        "scheduleSourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
